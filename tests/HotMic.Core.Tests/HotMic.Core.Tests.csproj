<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707;xUnit1004</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NAudio" Version="2.2.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HotMic.Core\HotMic.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="data\noisy_voice_4sec.wav" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\default.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\HotMic.App\Assets\Models\silero-vad\silero_vad.onnx">
      <Link>Assets\Models\silero-vad\silero_vad.onnx</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\HotMic.App\Assets\Models\speechdenoiser\denoiser_model.onnx">
      <Link>Assets\Models\speechdenoiser\denoiser_model.onnx</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
